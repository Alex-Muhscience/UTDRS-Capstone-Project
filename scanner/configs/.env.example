# The collection server reads only MONGODB_URI from the environment. Scans are stored
# in the utdrs_db database, collection scans.
MONGODB_URI=mongodb://localhost:27017

# Fixed in the code for now: port 8443, certificates under configs/certs/
# (ca.crt, server.crt, server.key for the server; ca.crt, agent.crt, agent.key for the agent).
# The agent's settings are in configs/agent.conf.
