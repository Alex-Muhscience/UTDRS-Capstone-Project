# Base URL of the API gateway, e.g. https://api.example.com
# Leave empty when the dashboard is served from the same origin as the gateway's /api
# (the Vite dev server, `vite preview` and the Docker image all proxy /api to it).
VITE_API_URL=

# Used by the dev and preview servers' /api proxy (not bundled into the app).
UTDRS_GATEWAY_URL=http://localhost:8000
