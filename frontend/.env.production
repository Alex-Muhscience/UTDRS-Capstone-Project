# Production environment variables for UTDRS Frontend
# These will be used during the Netlify build process

# API Configuration - Update these to your production backend URLs
VITE_API_URL="https://api.example.com/api/v1"
VITE_WS_URL="wss://api.example.com/ws"

# Application Settings
VITE_APP_NAME="UTDRS"
VITE_APP_VERSION="1.0.0"
VITE_DEBUG="false"

# Feature Flags
VITE_ENABLE_ANALYTICS="true"
VITE_ENABLE_ERROR_TRACKING="true"

# Security
VITE_CSRF_TOKEN_HEADER="X-CSRF-Token"
VITE_TOKEN_STORAGE="session"

# Monitoring and Logging
VITE_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
VITE_GA_ID="UA-XXXXXXXXX-X"

# API Timeouts (in milliseconds)
VITE_API_TIMEOUT="30000"

# Rate Limiting
VITE_RATE_LIMIT_ENABLED="true"
VITE_RATE_LIMIT_WINDOW="60000"
VITE_RATE_LIMIT_MAX_ATTEMPTS="5"
