# Settings for `docker compose`. Copy to .env and fill in; never commit .env.
#
# Generate each secret with one of:
#   openssl rand -base64 48
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Required: JWT_SECRET, INTERNAL_API_TOKEN and ADMIN_PASSWORD (8 to 72 characters).

# Signs session tokens. Changing it signs everyone out.
JWT_SECRET=
# Shared secret between UTDRS's own services: the gateway and the core engine, and
# the data processor that delivers device scans to the gateway.
INTERNAL_API_TOKEN=

# The first administrator, created when the gateway starts (and restored as an
# active admin on every start, so this is also how to recover admin access).
# The password is only used to create the account; change it in the dashboard after.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Whether anyone can register an analyst account. With false, admins create accounts.
ALLOW_REGISTRATION=true
# join: a new account is an analyst in this deployment's organisation.
# organisation: registering creates a separate organisation, with the person as its
# administrator, for hosting several organisations on one deployment.
REGISTRATION_MODE=join

# Email notifications (new cases, approvals needed, actions taken). Leave SMTP_HOST
# empty to send nothing. SMTP_SECURITY: starttls (port 587), ssl (465) or none (a
# local relay only). DASHBOARD_URL is where links in emails point.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
MAIL_FROM="UTDRS <utdrs@example.com>"
DASHBOARD_URL=http://localhost:8080

# Encrypts secrets stored in the database, such as a Microsoft 365 client secret:
# openssl rand -base64 32. Keep it safe: without it, stored secrets cannot be read.
# To rotate, set the new key here and the old one as ENCRYPTION_KEY_PREVIOUS.
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# Microsoft 365. Organisations can always connect with an app registration of their
# own. To offer "Connect with Microsoft" (admin consent) instead, register a
# multi-tenant app in Microsoft Entra with the permissions the Connectors page lists,
# add <dashboard>/connectors/microsoft-365/consented as a redirect URI, and set:
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_POLL_INTERVAL_SECONDS=300

# Ports on your machine, and the address they listen on. 127.0.0.1 keeps the stack
# private to this machine; 0.0.0.0 makes it reachable from your network.
BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8080
GATEWAY_PORT=8000
PROCESSOR_PORT=5000
SCANNER_PORT=8443

# Optional threat-intelligence lookups in the core engine.
ENABLE_THREAT_INTEL=false
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
