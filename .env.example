# Settings for `docker compose`. Copy to .env and fill in; never commit .env.
#
# Generate each secret with one of:
#   openssl rand -base64 48
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Signs session tokens. Changing it signs everyone out.
JWT_SECRET=
# Shared secret between the API gateway and the core engine.
INTERNAL_API_TOKEN=

# Password for the demo account that `docker compose run --rm seed` creates.
# Leave empty to have one generated and printed.
DEMO_PASSWORD=

# Ports on your machine, and the address they listen on. 127.0.0.1 keeps the stack
# private to this machine; 0.0.0.0 makes it reachable from your network.
BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8080
GATEWAY_PORT=8000
PROCESSOR_PORT=5000
SCANNER_PORT=8443

# Optional threat-intelligence lookups in the core engine.
ENABLE_THREAT_INTEL=false
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
