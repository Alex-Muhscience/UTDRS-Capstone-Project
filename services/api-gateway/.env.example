# Copy to .env (never commit it) and fill in. Every setting can also be an environment variable.

# MongoDB. The gateway's own database: do not share it with the core engine.
MONGODB_URI=mongodb://localhost:27017
DB_NAME=utdrs

# Signs session tokens. Required: the gateway will not start without it. Use a long random
# value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))", and uncomment.
# JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# The first administrator: made an active admin on every start, and created with
# ADMIN_PASSWORD (8 to 72 characters) if it does not exist.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
ADMIN_EMAIL=
# Whether anyone can register an analyst account; with false, admins create accounts.
ALLOW_REGISTRATION=true

# Origins allowed to call the API from a browser (JSON list). Not needed when the
# dashboard is served from the same origin (its dev server, preview and Docker image proxy /api).
CORS_ORIGINS=["http://localhost:5173"]
# Host headers to accept (JSON list); ["*"] accepts any.
ALLOWED_HOSTS=["*"]

# Core engine. When set, every stored event is sent there for analysis and threats become alerts.
CORE_ENGINE_URL=http://localhost:8001
CORE_ENGINE_TIMEOUT_SECONDS=10
# Shared secret sent to the engine as X-Internal-Token; set the same value on the engine.
INTERNAL_API_TOKEN=

# Email notifications (new cases, approvals needed, actions taken). Leave SMTP_HOST
# empty to send nothing. SMTP_SECURITY: starttls (port 587), ssl (465) or none (a
# local relay only). DASHBOARD_URL is where links in emails point.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
MAIL_FROM="UTDRS <utdrs@example.com>"
DASHBOARD_URL=http://localhost:5173

# Encrypts secrets stored in the database, such as a Microsoft 365 client secret:
# openssl rand -base64 32. Keep it safe: without it, stored secrets cannot be read.
# To rotate, set the new key here and the old one as ENCRYPTION_KEY_PREVIOUS.
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# Microsoft 365. Organisations can always connect with an app registration of their
# own. To offer "Connect with Microsoft" (admin consent) instead, register a
# multi-tenant app in Microsoft Entra with the permissions the Connectors page lists,
# add <dashboard>/connectors/microsoft-365/consented as a redirect URI, and set:
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_POLL_INTERVAL_SECONDS=300

# Data retention, in days: the defaults each organisation starts with (it can change
# them, up to RETENTION_MAX_DAYS). Open cases and alerts, and their events, are kept.
RETENTION_EVENTS_DAYS=90
RETENTION_ALERTS_DAYS=365
RETENTION_MAX_DAYS=730

DEBUG=false
API_PREFIX=/api/v1
