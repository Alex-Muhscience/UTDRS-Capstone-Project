# Copy to .env (never commit it) and fill in. Every setting can also be an environment variable.

# MongoDB. The engine's own database: its events, alerts and rules have a different
# shape from the gateway's, so the two must not share one.
MONGODB_URI=mongodb://localhost:27017
DB_NAME=utdrs_engine

# Shared secret the gateway sends as X-Internal-Token. When set, /rules and /detections
# refuse requests without it (/health stays open). Set the same value on the gateway.
INTERNAL_API_TOKEN=

# Detectors
ENABLE_YARA=true
ENABLE_CORRELATION=true
CORRELATION_WINDOW=60
ANOMALY_BASELINE_DAYS=7
MODEL_PATH=ml_models

# Threat intelligence lookups (optional; each provider is used only when its key is set)
ENABLE_THREAT_INTEL=false
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

DEBUG=false
LOG_LEVEL=INFO
